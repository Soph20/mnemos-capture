{
  "name": "mnemos-capture",
  "version": "1.2.1",
  "description": "Turn what you discover into context your AI workers can use. Capture once, then brief, plan, and execute with any MCP-compatible tool.",
  "type": "module",
  "bin": {
    "mnemos-capture": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "tsc -p cli/tsconfig.json",
    "prepublishOnly": "npm run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "knowledge",
    "capture",
    "claude",
    "claude-code",
    "mcp",
    "agents",
    "agentic",
    "llm",
    "workflow"
  ],
  "author": "Sofía Padrón Valdez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soph20/mnemos-capture.git"
  },
  "homepage": "https://github.com/Soph20/mnemos-capture",
  "files": [
    "dist/cli/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@vercel/postgres": "^0.10.0",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.9"
  }
}
